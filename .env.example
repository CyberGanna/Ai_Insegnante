# Copia in .env.local. Senza queste variabili l'app parte in modalità prova
# (dati nel browser, esaminatore simulato, voce e trascrizione del browser).

# Supabase: Project Settings > API. Solo la chiave pubblicabile, mai la service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Facoltativo: scegli ogni parte separatamente (remote = Edge Functions, altrimenti prova/browser).
# NEXT_PUBLIC_AI_EXAMINER=remote   # remote | mock
# NEXT_PUBLIC_AI_STT=remote        # remote | browser
# NEXT_PUBLIC_AI_TTS=remote        # remote | browser  (browser se usi solo Gemini gratis)
