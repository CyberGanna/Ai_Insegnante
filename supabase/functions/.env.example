# Segreti delle Edge Functions: in Supabase > Edge Functions > Secrets
# (oppure: supabase secrets set --env-file supabase/functions/.env).

# --- Per partire gratis: solo Google Gemini (chiave da aistudio.google.com) ---
LLM_PROVIDER=gemini               # gemini | anthropic | openai | compatibile
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Con LLM_PROVIDER=gemini anche la trascrizione usa Gemini (STT_PROVIDER=gemini).
# La voce dell'esaminatore resta quella del browser: nel sito NEXT_PUBLIC_AI_TTS=browser.

# --- Qwen, DeepSeek, Llama… tramite OpenRouter o altri servizi in stile OpenAI ---
# LLM_PROVIDER=compatibile
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3-vl-235b-a22b-instruct   # serve un modello "VL" per leggere foto e PDF

# --- Qualità massima: Claude per il cervello, OpenAI per trascrizione, ElevenLabs per la voce ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-5-mini         # solo con LLM_PROVIDER=openai
# STT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# TTS_PROVIDER=elevenlabs         # elevenlabs | openai
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_CALMA=         # ID di una voce italiana calma
# ELEVENLABS_VOICE_SEVERA=        # ID di una voce italiana più severa
